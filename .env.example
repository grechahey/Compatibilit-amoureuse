# Copiez ce fichier en .env et renseignez vos vraies valeurs.
PORT=3000
DB_PATH=./data/amesoeur.db
NODE_ENV=production
BASE_URL=https://votredomaine.fr

# Identité légale affichée dans la politique de confidentialité (RGPD)
ORG_NAME=Votre Société SAS
ORG_LEGAL=SIREN 000 000 000 — 1 rue Exemple, 75000 Paris
DPO_EMAIL=dpo@votredomaine.fr
CONTACT_EMAIL=contact@votredomaine.fr

# Envoi des emails de vérification (sinon, mode démo : lien affiché à l'écran)
# Exemple : smtps://user:pass@smtp.votredomaine.fr:465
SMTP_URL=
MAIL_FROM=no-reply@votredomaine.fr

# Paiements Stripe (sinon, crédits simulés en mode démo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MESSAGE=price_xxx
STRIPE_PRICE_SUPER=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx
