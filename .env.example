# Copiez ce fichier en .env et renseignez vos vraies valeurs.
PORT=3000
DB_PATH=./data/amesoeur.db
NODE_ENV=production
BASE_URL=https://votredomaine.fr

# Identité légale affichée dans la politique de confidentialité (RGPD)
ORG_NAME=Votre Société SAS
ORG_LEGAL=SIREN 000 000 000 — 1 rue Exemple, 75000 Paris
DPO_EMAIL=dpo@votredomaine.fr
CONTACT_EMAIL=contact@votredomaine.fr

# Back office admin : emails autorisés (séparés par des virgules). Ces comptes
# accèdent à /admin (stats marketing, membres, audit de match, pondérations).
# Vide => back office désactivé (aucun admin).
ADMIN_EMAILS=vous@votredomaine.fr

# Envoi des emails de vérification ET des notifications (nouveau match, message,
# Super Like). Sans SMTP : mode démo, les emails sont journalisés dans la console.
# Exemple : smtps://user:pass@smtp.votredomaine.fr:465  — puis `npm i nodemailer`.
SMTP_URL=
MAIL_FROM=no-reply@votredomaine.fr

# Notifications push (Web Push). Générez une paire de clés VAPID :
#   npx web-push generate-vapid-keys   (puis `npm i web-push`)
# Sans ces clés, le push est simplement inactif (l'email reste actif).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votredomaine.fr

# Paiements Stripe (sinon, crédits simulés en mode démo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MESSAGE=price_xxx
STRIPE_PRICE_SUPER=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

# Stockage des photos sur S3 (sinon, conservées en base en data-URL)
# Compatible AWS S3, Cloudflare R2, Scaleway, MinIO… via S3_ENDPOINT.
S3_BUCKET=
S3_REGION=eu-west-3
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # pour R2/MinIO
# S3_PUBLIC_BASE=https://cdn.votredomaine.fr                  # URL/CDN publique
